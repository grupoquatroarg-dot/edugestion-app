# Server Configuration
PORT=3000
NODE_ENV=development
# Obligatorio en producción. Generar, por ejemplo:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Solo se usan cuando SQLite no tiene ningún administrador activo.
# La contraseña debe tener 12+ caracteres y no debe compartirse ni subirse a Git.
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@edugestion.com
BOOTSTRAP_ADMIN_PASSWORD=

# Local SQLite (se mantiene para los modulos que todavia no migramos)
DB_NAME=database.db

# Supabase / Postgres (activa usuarios + auth sobre Supabase cuando DATABASE_URL tiene valor)
DATABASE_URL=
DATABASE_SSL=true

# Security
CLIENT_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
